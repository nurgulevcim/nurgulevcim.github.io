source "https://rubygems.org"

# Jekyll çekirdek ve tema
gem "jekyll", "~> 4.3.4"

# Minimum gerekli eklentiler
gem "jekyll-paginate"
gem "jekyll-seo-tag"
gem "jekyll-feed"
gem "jekyll-include-cache"

# 🔥 Kategoriler & arşivlerin çalışması için şart!
gem "jekyll-archives"

group :jekyll_plugins do
  gem "jekyll-archives"
  gem "jekyll-paginate"
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
  gem "jekyll-include-cache"
end
